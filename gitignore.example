# File gitignore per progetti JavaScript/TypeScript

# Dipendenze
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
.next/
.nuxt/
.output/

# Temporanei
*.tmp
*.temp
.cache/
.parcel-cache/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor e IDE
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Test coverage
coverage/
*.lcov
.nyc_output/

# TypeScript
*.tsbuildinfo

# ESLint
.eslintcache

# Prettier
.prettiercache

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Package-lock files (choose one based on package manager)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local development
.local
*.local

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional dependencies
.optional

# Storybook build outputs
storybook-static/